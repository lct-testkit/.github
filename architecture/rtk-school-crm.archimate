  <folder name="Views" id="id-0c8dfef7f89e4b7dabf73b70249ad03e" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" name="Обзор архитектуры" id="id-7bd14e8433aa40548ddfd7882f72adde" viewpoint="business_process_cooperation">
      <child xsi:type="archimate:DiagramObject" id="id-740d27a6eda64dd6bfdc248ed0a6f0b8" targetConnections="id-f7c0e34c6ef740a1ad8bfc0ce567944e" archimateElement="id-actor-admin">
        <bounds x="20" y="20" width="120" height="55"/>
