<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="RTK School CRM — функциональная и компонентная архитектура" id="id-rtk-school-crm" version="5.0.0">
  <folder name="Strategy" id="id-170dc91119304b32bc8dd66243b4b5b6" type="strategy"/>
  <folder name="Business" id="id-940943262825447b951acf484999402e" type="business">
    <folder name="Бизнес-слой" id="id-22d4547b047d4fe9b00b3ca1b4d9ff87">
      <element xsi:type="archimate:BusinessActor" name="КАМ (менеджер по вузам)" id="id-actor-kam">
        <documentation>Ведёт свои сделки, организации своих сделок, свои задачи, входящие документы на подпись.</documentation>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Руководитель (HEAD)" id="id-actor-head">
        <documentation>Видит и переназначает сделки команды, запускает импорт каталогов, согласования, отчёты по команде.</documentation>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Администратор (ADMIN)" id="id-actor-admin">
        <documentation>Настраивает воронки, справочники, интеграции, пользователей; необратимые операции подтверждает второй администратор («четыре глаза»).</documentation>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Аудитор (AUDITOR)" id="id-actor-auditor">
        <documentation>Только чтение: журнал аудита, проверка целостности цепочки хэшей, экспорт.</documentation>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Внешний подписант" id="id-actor-signer-ext">
        <documentation>Сотрудник вуза или физлицо; подписывает документ ПЭП по ссылке без входа в систему (/sign/{token}).</documentation>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Внешняя система (сайт, LMS)" id="id-actor-integration">
        <documentation>Сервисная учётная запись INTEGRATION: входящие лиды с сайта, прогресс обучения из LMS, вебхуки по HMAC-подписи.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Ведение сделки по воронке" id="id-bp-deal">
        <documentation>Создание сделки → переходы по настраиваемому графу статусов с условиями, ролями и SLA → закрытие (успех/отказ) или заморозка.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Идентификация организации по ИНН" id="id-bp-org">
        <documentation>Поиск в локальном реестре ЕГРЮЛ (офлайн), автоподстановка реквизитов, обнаружение дублей и расхождений.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Подписание документа (ПЭП)" id="id-bp-sign">
        <documentation>Отправка документа подписантам → просмотр → подтверждение кодом по независимому каналу → протокол, хэш, штамп.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Импорт каталога" id="id-bp-import">
        <documentation>Загрузка xlsx/xls/csv → сопоставление колонок → пробный прогон → применение (insert/upsert) → возможный откат.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Формирование отчёта" id="id-bp-report">
        <documentation>Выбор шаблона и параметров → построение (синхронно или в очереди) → выгрузка в xlsx/pdf/png по ссылке, действующей ограниченное время.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Удаление персональных данных" id="id-bp-erasure">
        <documentation>Запрос → проверка блокеров → отсрочка 30 дней → исполнение (обезличивание/удаление) → акт, подтверждённый вторым администратором.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Контроль неизменяемого аудита" id="id-bp-audit">
        <documentation>Каждое действие пишется в журнал с цепочкой хэшей; целостность проверяется по требованию.</documentation>
      </element>
      <element xsi:type="archimate:BusinessService" name="Продажа образовательных программ вузам и физлицам" id="id-bs-crm">
        <documentation>Итоговая бизнес-услуга: путь от первого контакта с вузом до запуска обучения виден и управляем целиком.</documentation>
      </element>
    </folder>
  </folder>
  <folder name="Application" id="id-354446de7b64460c9a9235092e80bee4" type="application">
    <folder name="Прикладной слой" id="id-75f7902b8a0145eaae1e1f9f93e80a61">
      <element xsi:type="archimate:ApplicationComponent" name="Веб-клиент (SvelteKit SPA)" id="id-app-web">
        <documentation>Единственная точка взаимодействия пользователя с системой; типизированный клиент по OpenAPI, курсорная пагинация, оптимистичная блокировка (If-Match), Idempotency-Key.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="API-бэкенд (FastAPI, модульный монолит)" id="id-app-api">
        <documentation>13 модулей (crm, workflow, catalog, identity, signing, imports, reporting, integration, admin, audit, files, registry, notification); RFC 7807, BFF-схема для Keycloak.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Фоновый воркер (arq)" id="id-app-worker">
        <documentation>SLA-эскалации, построение тяжёлых отчётов, обработка импорта, отправка уведомлений — асинхронно, через очередь в Redis.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Управление сделками и воронкой" id="id-appsvc-deal"/>
      <element xsi:type="archimate:ApplicationService" name="Организации, контакты, реестр ЕГРЮЛ" id="id-appsvc-org"/>
      <element xsi:type="archimate:ApplicationService" name="Электронная подпись (ПЭП)" id="id-appsvc-sign"/>
      <element xsi:type="archimate:ApplicationService" name="Импорт каталогов" id="id-appsvc-import"/>
      <element xsi:type="archimate:ApplicationService" name="Отчётность и дашборды" id="id-appsvc-report"/>
      <element xsi:type="archimate:ApplicationService" name="Идентификация и доступ (OIDC / BFF)" id="id-appsvc-auth">
        <documentation>Демо: пароль-грант в браузере. Прод: код-грант + PKCE, серверная сессия, httpOnly-cookie — токены не покидают Redis.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Неизменяемый аудит" id="id-appsvc-audit"/>
      <element xsi:type="archimate:ApplicationService" name="Уведомления" id="id-appsvc-notify"/>
      <element xsi:type="archimate:ApplicationInterface" name="REST API (/api/*)" id="id-appif-rest"/>
      <element xsi:type="archimate:ApplicationInterface" name="Публичные страницы (/public/*, /sign, /verify)" id="id-appif-public">
        <documentation>Подпись и проверка подписи без входа в систему.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="Вебхуки внешних систем (/api/v1/integrations/*)" id="id-appif-webhook">
        <documentation>Подписаны секретом (HMAC); вызываются сайтом и LMS напрямую, минуя браузер.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Сделка" id="id-do-deal"/>
      <element xsi:type="archimate:DataObject" name="Организация / контакт" id="id-do-org"/>
      <element xsi:type="archimate:DataObject" name="Документ подписи" id="id-do-doc"/>
      <element xsi:type="archimate:DataObject" name="Отчёт / задание отчёта" id="id-do-report"/>
      <element xsi:type="archimate:DataObject" name="Задание импорта" id="id-do-import"/>
      <element xsi:type="archimate:DataObject" name="Запись аудита" id="id-do-audit"/>
      <element xsi:type="archimate:DataObject" name="Пользователь / команда" id="id-do-user"/>
      <element xsi:type="archimate:DataObject" name="Файл (вложение, скан, отчёт)" id="id-do-file"/>
    </folder>
  </folder>
  <folder name="Technology &amp; Physical" id="id-7992e0c907b94da5a4b4bd493e11ab33" type="technology">
    <folder name="Технологический слой" id="id-0bd860097ec142e8ac1d1876afba7f9b">
      <element xsi:type="archimate:Node" name="Caddy" id="id-node-caddy">
        <documentation>Единая точка входа: TLS-терминация, маршрутизация /api /auth /public на соответствующие сервисы, CSP/HSTS/X-Request-Id.</documentation>
      </element>
      <element xsi:type="archimate:Node" name="PostgreSQL 16" id="id-node-postgres"/>
      <element xsi:type="archimate:Node" name="Redis 7" id="id-node-redis">
        <documentation>Сессии BFF, кэш прав, идемпотентность, очередь arq.</documentation>
      </element>
      <element xsi:type="archimate:Node" name="SeaweedFS" id="id-node-seaweed">
        <documentation>S3-совместимое объектное хранилище файлов; presigned-ссылки, браузер обращается к нему напрямую минуя API.</documentation>
      </element>
      <element xsi:type="archimate:Node" name="Keycloak 25" id="id-node-keycloak">
        <documentation>OIDC-провайдер, realm crm, пять демо-ролей.</documentation>
      </element>
      <element xsi:type="archimate:TechnologyService" name="Реляционное хранилище" id="id-techsvc-db"/>
      <element xsi:type="archimate:TechnologyService" name="Кэш, сессии и очередь задач" id="id-techsvc-cache"/>
      <element xsi:type="archimate:TechnologyService" name="Объектное S3-хранилище" id="id-techsvc-s3"/>
      <element xsi:type="archimate:TechnologyService" name="OIDC-провайдер" id="id-techsvc-oidc"/>
      <element xsi:type="archimate:TechnologyService" name="TLS-терминация и маршрутизация" id="id-techsvc-gw"/>
      <element xsi:type="archimate:Artifact" name="Docker-образ api" id="id-artifact-api"/>
      <element xsi:type="archimate:Artifact" name="Docker-образ worker" id="id-artifact-worker"/>
      <element xsi:type="archimate:Artifact" name="Docker-образ web (клиент)" id="id-artifact-web"/>
    </folder>
  </folder>
  <folder name="Motivation" id="id-bea6e7d6c1ca47718b6696aaa53e31fd" type="motivation"/>
  <folder name="Implementation &amp; Migration" id="id-aba508bec0ab4717a512add1d3cdb5c0" type="implementation_migration"/>
