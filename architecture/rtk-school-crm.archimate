        <sourceConnection xsi:type="archimate:Connection" id="id-98478fff326443cfb060bc0ca5e82e8e" source="id-740d27a6eda64dd6bfdc248ed0a6f0b8" target="id-5dfafcb87bd54122bf45fbc3d5501a94" archimateRelationship="id-rel-5"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-28aa8fb9227644caa2029d40f6dd1818" targetConnections="id-3b21371c7cee430fa393fc4509305fbd" archimateElement="id-actor-auditor">
        <bounds x="20" y="120" width="120" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-56189b2db5c6445494bd0a3ded713391" source="id-28aa8fb9227644caa2029d40f6dd1818" target="id-4d36b0c9bdf54b1eaff87bbdbfeb4b1a" archimateRelationship="id-rel-6"/>
